---
import { guideCards } from '../data/guide-cards';

interface Props {
	heading?: string;
	exclude?: string;
	/** Limit cards shown (default 4) */
	limit?: number;
}

const { heading = 'Keep reading on this site', exclude, limit = 4 } = Astro.props;
const items = guideCards.filter((card) => card.href !== exclude).slice(0, limit);
---

{
	items.length > 0 && (
		<section class="related-rail" aria-labelledby="related-rail-heading">
			<div class="related-rail-inner">
				<div class="related-rail-head">
					<p class="eyebrow">Related on this site</p>
					<h2 id="related-rail-heading">{heading}</h2>
				</div>
				<ul class="related-track" role="list">
					{items.map((card) => (
						<li>
							<a class="related-card" href={card.href}>
								<img
									src={card.image}
									alt=""
									width="480"
									height="300"
									loading="lazy"
									decoding="async"
								/>
								<span class="related-copy">
									<span class="related-title">{card.title}</span>
									<span class="related-more">Read on site →</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.related-rail {
		background: var(--paper);
		padding-block: clamp(2.5rem, 6vw, 3.75rem);
		overflow: hidden;
	}

	.related-rail-inner {
		width: min(1120px, calc(100% - 2.5rem));
		margin-inline: auto;
	}

	.related-rail-head {
		margin-bottom: 1.15rem;
		max-width: 36rem;
	}

	.related-rail-head h2 {
		margin: 0;
		font-size: clamp(1.45rem, 3vw, 1.95rem);
		color: var(--ink);
	}

	.related-track {
		list-style: none;
		margin: 0;
		padding: 0 0 0.35rem;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(15.5rem, 72vw);
		gap: 0.9rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
	}

	.related-track > li {
		scroll-snap-align: start;
	}

	.related-card {
		display: grid;
		gap: 0;
		height: 100%;
		text-decoration: none;
		color: inherit;
		background: var(--white);
		border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: 0 10px 24px color-mix(in srgb, var(--ink) 6%, transparent);
	}

	.related-card img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.related-copy {
		display: grid;
		gap: 0.4rem;
		padding: 0.85rem 0.95rem 1rem;
	}

	.related-title {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 560;
		color: var(--ink);
		line-height: 1.3;
	}

	.related-more {
		font-size: 0.9rem;
		font-weight: 650;
		color: var(--forest);
	}

	@media (min-width: 900px) {
		.related-track {
			grid-auto-flow: row;
			grid-auto-columns: unset;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			overflow: visible;
		}
	}
</style>
