---
import BrandLogo from './BrandLogo.astro';
import { NAV_AREAS, NAV_FEES, NAV_GUIDE_MENU, SITE } from '../data/site';

interface Props {
	variant?: 'overlay' | 'solid';
}

/** Overlay kept for API compat — header is always sticky/solid so it never scrolls away */
const { variant: _variant = 'solid' } = Astro.props;
---

<header class="site-header">
	<a class="brand" href="/">
		<BrandLogo size={34} />
		<span class="sr-only">{SITE.name}</span>
	</a>

	<nav class="nav-desktop" aria-label="Primary">
		<a href={NAV_FEES.href}>{NAV_FEES.label}</a>
		<details class="nav-drop" data-nav-drop>
			<summary>Guides</summary>
			<div class="nav-drop-panel" role="group" aria-label="Landlord guides">
				{NAV_GUIDE_MENU.map((item) => <a href={item.href}>{item.label}</a>)}
			</div>
		</details>
		<details class="nav-drop" data-nav-drop>
			<summary>Areas</summary>
			<div class="nav-drop-panel" role="group" aria-label="Local areas">
				{NAV_AREAS.map((item) => <a href={item.href}>{item.label}</a>)}
			</div>
		</details>
		<a href="/#faq">FAQ</a>
	</nav>

	<div class="header-actions">
		<a class="header-cta" href="/compare/">Compare</a>
		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-menu"
			data-menu-toggle
		>
			<span class="menu-toggle-bars" aria-hidden="true"></span>
			<span class="menu-toggle-label" data-menu-label>Menu</span>
		</button>
	</div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
	<nav class="mobile-nav" aria-label="Mobile">
		<a class="mobile-primary" href="/compare/">Compare by postcode</a>
		<a class="mobile-primary" href={NAV_FEES.href}>{NAV_FEES.label}</a>
		<a class="mobile-primary" href="/#faq">FAQ</a>

		<p class="mobile-label">Guides</p>
		{NAV_GUIDE_MENU.map((item) => <a href={item.href}>{item.label}</a>)}

		<details class="mobile-areas" open>
			<summary>Areas</summary>
			<div class="mobile-areas-list">
				{NAV_AREAS.map((item) => <a href={item.href}>{item.label}</a>)}
			</div>
		</details>
	</nav>
</div>

<script>
	const toggle = document.querySelector('[data-menu-toggle]');
	const menu = document.querySelector('[data-mobile-menu]');
	const menuLabel = document.querySelector('[data-menu-label]');
	if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
		const setOpen = (open) => {
			toggle.setAttribute('aria-expanded', String(open));
			menu.hidden = !open;
			document.body.classList.toggle('menu-open', open);
			if (menuLabel) menuLabel.textContent = open ? 'Close' : 'Menu';
		};

		toggle.addEventListener('click', (event) => {
			event.stopPropagation();
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		window.addEventListener('resize', () => {
			if (window.matchMedia('(min-width: 1040px)').matches) setOpen(false);
		});
	}

	const drops = document.querySelectorAll('[data-nav-drop]');
	drops.forEach((drop) => {
		drop.addEventListener('toggle', () => {
			if (!(drop instanceof HTMLDetailsElement) || !drop.open) return;
			drops.forEach((other) => {
				if (other !== drop && other instanceof HTMLDetailsElement) other.open = false;
			});
		});
	});

	document.addEventListener('pointerdown', (event) => {
		const target = event.target;
		if (!(target instanceof Node)) return;
		drops.forEach((drop) => {
			if (drop instanceof HTMLDetailsElement && drop.open && !drop.contains(target)) {
				drop.open = false;
			}
		});
	});
</script>

<style is:global>
	body.menu-open {
		overflow: hidden;
	}
</style>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem clamp(1rem, 3.5vw, 2.5rem);
		background: color-mix(in srgb, var(--ink) 94%, black);
		color: var(--cream);
		position: sticky;
		top: 0;
		z-index: 110;
		border-bottom: 2px solid var(--brass);
		box-shadow: 0 10px 28px color-mix(in srgb, black 28%, transparent);
		backdrop-filter: blur(10px);
		overflow: visible;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		min-width: 0;
		color: inherit;
		z-index: 1;
		flex-shrink: 1;
	}

	.nav-desktop {
		display: none;
		align-items: center;
		gap: 0.15rem;
		font-size: 0.95rem;
		font-weight: 550;
		flex-wrap: nowrap;
		position: relative;
		z-index: 3;
	}

	.nav-desktop > a,
	.nav-drop summary {
		text-decoration: none;
		opacity: 1;
		cursor: pointer;
		list-style: none;
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius-sm);
		color: color-mix(in srgb, var(--cream) 90%, white);
		white-space: nowrap;
		transition:
			background 0.2s var(--ease),
			color 0.2s var(--ease);
	}

	.nav-desktop > a:hover,
	.nav-drop summary:hover,
	.nav-drop[open] summary {
		background: color-mix(in srgb, var(--cream) 12%, transparent);
		color: var(--cream);
	}

	.nav-drop {
		position: relative;
		z-index: 4;
	}

	.nav-drop[open] {
		z-index: 5;
	}

	.nav-drop summary {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.nav-drop summary::-webkit-details-marker {
		display: none;
	}

	.nav-drop summary::after {
		content: '';
		width: 0.35rem;
		height: 0.35rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
		opacity: 0.8;
	}

	.nav-drop-panel {
		position: absolute;
		top: calc(100% + 0.55rem);
		left: 0;
		min-width: 14.5rem;
		max-height: min(70vh, 28rem);
		overflow: auto;
		padding: 0.45rem;
		background: var(--ink);
		border: 1px solid color-mix(in srgb, var(--brass) 45%, transparent);
		border-radius: var(--radius);
		box-shadow: 0 16px 36px color-mix(in srgb, black 35%, transparent);
		display: grid;
		gap: 0.1rem;
		z-index: 120;
	}

	.nav-drop-panel a {
		text-decoration: none;
		padding: 0.6rem 0.75rem;
		border-radius: calc(var(--radius-sm) - 2px);
		color: color-mix(in srgb, var(--cream) 92%, white);
		white-space: nowrap;
	}

	.nav-drop-panel a:hover {
		background: color-mix(in srgb, var(--cream) 10%, transparent);
		color: var(--cream);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		z-index: 2;
		flex-shrink: 0;
		position: relative;
	}

	.header-cta {
		display: inline-flex;
		text-decoration: none;
		font-weight: 650;
		font-size: 0.9rem;
		padding: 0.6rem 0.9rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		background: var(--brass);
		color: var(--ink);
		white-space: nowrap;
		transition:
			background 0.25s var(--ease),
			transform 0.25s var(--ease);
	}

	.header-cta:hover {
		background: color-mix(in srgb, var(--brass) 88%, white);
		transform: translateY(-1px);
	}

	.menu-toggle {
		position: relative;
		min-height: 2.65rem;
		min-width: 2.65rem;
		padding: 0.5rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--cream) 8%, transparent);
		color: inherit;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		font: inherit;
		font-size: 0.88rem;
		font-weight: 650;
		-webkit-tap-highlight-color: transparent;
		z-index: 3;
	}

	.menu-toggle:hover,
	.menu-toggle[aria-expanded='true'] {
		background: color-mix(in srgb, var(--brass) 22%, transparent);
		border-color: var(--brass);
	}

	.menu-toggle-label {
		line-height: 1;
	}

	.menu-toggle-bars,
	.menu-toggle-bars::before,
	.menu-toggle-bars::after {
		display: block;
		width: 1.1rem;
		height: 1.5px;
		background: var(--brass);
		position: relative;
	}

	.menu-toggle-bars::before,
	.menu-toggle-bars::after {
		content: '';
		position: absolute;
		left: 0;
		background: var(--brass);
	}

	.menu-toggle-bars::before {
		top: -5px;
	}

	.menu-toggle-bars::after {
		top: 5px;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bars {
		background: transparent;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bars::before {
		top: 0;
		transform: rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bars::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--ink) 97%, black);
		color: var(--cream);
		padding:
			calc(4.75rem + env(safe-area-inset-top))
			clamp(1.15rem, 4vw, 2rem)
			calc(1.75rem + env(safe-area-inset-bottom));
		overflow: auto;
		-webkit-overflow-scrolling: touch;
	}

	.mobile-menu[hidden] {
		display: none !important;
	}

	.mobile-nav {
		display: grid;
		gap: 0.15rem;
		max-width: 28rem;
		margin-inline: auto;
	}

	.mobile-primary {
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 560;
		padding: 0.85rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--cream) 14%, transparent);
	}

	.mobile-label {
		margin: 1.35rem 0 0.4rem;
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--brass);
	}

	.mobile-nav > a:not(.mobile-primary) {
		text-decoration: none;
		font-size: 1.08rem;
		font-weight: 550;
		padding: 0.8rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--cream) 10%, transparent);
		min-height: 2.75rem;
		display: flex;
		align-items: center;
	}

	.mobile-areas {
		margin-top: 1.35rem;
		border-top: 1px solid color-mix(in srgb, var(--cream) 14%, transparent);
		padding-top: 0.35rem;
	}

	.mobile-areas summary {
		list-style: none;
		cursor: pointer;
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--brass);
		padding: 0.75rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.mobile-areas summary::-webkit-details-marker {
		display: none;
	}

	.mobile-areas summary::after {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg);
		opacity: 0.85;
	}

	.mobile-areas[open] summary::after {
		transform: rotate(225deg);
	}

	.mobile-areas-list {
		display: grid;
		gap: 0;
		padding-bottom: 0.5rem;
	}

	.mobile-areas-list a {
		text-decoration: none;
		font-size: 1.05rem;
		font-weight: 550;
		padding: 0.75rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--cream) 10%, transparent);
		min-height: 2.65rem;
		display: flex;
		align-items: center;
	}

	@media (max-width: 420px) {
		.menu-toggle-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}
	}

	/* Keep hamburger until there is room for Fees + Guides + Areas + FAQ */
	@media (min-width: 1040px) {
		.nav-desktop {
			display: flex;
		}

		.header-cta {
			padding: 0.65rem 1.05rem;
			font-size: 0.92rem;
		}

		.menu-toggle,
		.mobile-menu {
			display: none !important;
		}
	}

	@media (max-width: 1039px) {
		.nav-desktop {
			display: none !important;
		}

		.menu-toggle {
			display: inline-flex !important;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.header-cta,
		.nav-desktop > a,
		.nav-drop summary {
			transition: none;
		}

		.header-cta:hover {
			transform: none;
		}
	}
</style>
