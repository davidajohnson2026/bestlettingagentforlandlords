---
import BrandLogo from './BrandLogo.astro';
import { NAV_AREAS, NAV_GUIDES, SITE } from '../data/site';

interface Props {
	variant?: 'overlay' | 'solid';
}

const { variant = 'solid' } = Astro.props;
---

<header class:list={['site-header', variant === 'overlay' && 'is-overlay']}>
	<a class="brand" href="/">
		<BrandLogo size={40} />
		<span class="sr-only">{SITE.name}</span>
	</a>

	<nav class="nav-desktop" aria-label="Primary">
		{
			NAV_GUIDES.map((item) => (
				<a href={item.href}>{item.label}</a>
			))
		}
		<details class="nav-areas">
			<summary>Areas</summary>
			<div class="nav-areas-panel" role="group" aria-label="Local areas">
				{NAV_AREAS.map((item) => <a href={item.href}>{item.label}</a>)}
			</div>
		</details>
		<a href="/#faq">FAQ</a>
	</nav>

	<div class="header-actions">
		<a class="header-cta" href="/compare/">Compare agents</a>
		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-menu"
			data-menu-toggle
		>
			<span class="menu-toggle-bars" aria-hidden="true"></span>
			<span class="menu-toggle-label">Menu</span>
		</button>
	</div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
	<nav class="mobile-nav" aria-label="Mobile">
		<p class="mobile-label">Guides</p>
		{NAV_GUIDES.map((item) => <a href={item.href}>{item.label}</a>)}
		<p class="mobile-label">Areas</p>
		{NAV_AREAS.map((item) => <a href={item.href}>{item.label}</a>)}
		<a href="/#faq">FAQ</a>
		<a class="mobile-cta" href="/compare/">Compare agents</a>
	</nav>
</div>

<script>
	const toggle = document.querySelector('[data-menu-toggle]');
	const menu = document.querySelector('[data-mobile-menu]');
	if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
		const setOpen = (open) => {
			toggle.setAttribute('aria-expanded', String(open));
			menu.hidden = !open;
			document.body.classList.toggle('menu-open', open);
		};

		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});
	}
</script>

<style is:global>
	body.menu-open {
		overflow: hidden;
	}
</style>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.95rem clamp(1.25rem, 4vw, 3rem);
		background: var(--ink);
		color: var(--cream);
		position: sticky;
		top: 0;
		z-index: 30;
	}

	.site-header.is-overlay {
		position: absolute;
		inset: 0 0 auto;
		background: transparent;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		min-width: 0;
		color: inherit;
		z-index: 1;
	}

	.nav-desktop {
		display: none;
		align-items: center;
		gap: 1.15rem;
		font-size: 0.92rem;
	}

	.nav-desktop > a,
	.nav-areas summary {
		text-decoration: none;
		opacity: 0.88;
		cursor: pointer;
		list-style: none;
		transition: opacity 0.25s var(--ease);
	}

	.nav-desktop > a:hover,
	.nav-areas summary:hover,
	.nav-areas[open] summary {
		opacity: 1;
	}

	.nav-areas {
		position: relative;
	}

	.nav-areas summary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.nav-areas summary::-webkit-details-marker {
		display: none;
	}

	.nav-areas summary::after {
		content: '';
		width: 0.35rem;
		height: 0.35rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
		opacity: 0.8;
	}

	.nav-areas-panel {
		position: absolute;
		top: calc(100% + 0.65rem);
		left: 50%;
		transform: translateX(-50%);
		min-width: 13rem;
		max-height: min(70vh, 28rem);
		overflow: auto;
		padding: 0.55rem;
		background: var(--ink);
		border: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
		display: grid;
		gap: 0.15rem;
	}

	.nav-areas-panel a {
		text-decoration: none;
		padding: 0.55rem 0.7rem;
		opacity: 0.9;
	}

	.nav-areas-panel a:hover {
		background: color-mix(in srgb, var(--cream) 10%, transparent);
		opacity: 1;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		z-index: 1;
	}

	.header-cta {
		display: none;
		text-decoration: none;
		font-weight: 650;
		font-size: 0.9rem;
		padding: 0.65rem 1rem;
		border: 1px solid color-mix(in srgb, var(--cream) 35%, transparent);
		transition:
			background 0.25s var(--ease),
			border-color 0.25s var(--ease);
	}

	.header-cta:hover {
		background: color-mix(in srgb, var(--cream) 12%, transparent);
		border-color: color-mix(in srgb, var(--cream) 55%, transparent);
	}

	.menu-toggle {
		min-height: 2.6rem;
		padding: 0.45rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--cream) 35%, transparent);
		background: transparent;
		color: inherit;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 650;
	}

	.menu-toggle-label {
		line-height: 1;
	}

	.menu-toggle-bars,
	.menu-toggle-bars::before,
	.menu-toggle-bars::after {
		display: block;
		width: 1.1rem;
		height: 1.5px;
		background: currentColor;
		position: relative;
	}

	.menu-toggle-bars::before,
	.menu-toggle-bars::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.menu-toggle-bars::before {
		top: -5px;
	}

	.menu-toggle-bars::after {
		top: 5px;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bars {
		background: transparent;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bars::before {
		top: 0;
		transform: rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bars::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: 25;
		background: color-mix(in srgb, var(--ink) 96%, black);
		color: var(--cream);
		padding: 5.5rem clamp(1.25rem, 4vw, 3rem) 2rem;
		overflow: auto;
	}

	.mobile-menu[hidden] {
		display: none;
	}

	.mobile-nav {
		display: grid;
		gap: 0.35rem;
		max-width: 28rem;
	}

	.mobile-label {
		margin: 1rem 0 0.35rem;
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--brass);
	}

	.mobile-label:first-child {
		margin-top: 0;
	}

	.mobile-nav a {
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.25rem;
		padding: 0.55rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--cream) 12%, transparent);
	}

	.mobile-cta {
		margin-top: 1.25rem;
		display: inline-flex !important;
		justify-content: center;
		padding: 0.9rem 1.1rem !important;
		border: 1px solid transparent !important;
		background: var(--brass);
		color: var(--ink) !important;
		font-family: var(--font-body) !important;
		font-size: 1rem !important;
		font-weight: 650;
	}

	@media (min-width: 960px) {
		.nav-desktop {
			display: flex;
		}

		.header-cta {
			display: inline-flex;
		}

		.menu-toggle,
		.mobile-menu {
			display: none !important;
		}
	}
</style>
