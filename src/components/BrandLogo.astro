---
interface Props {
	size?: number;
	showWordmark?: boolean;
	tone?: 'light' | 'dark';
}

const { size = 36, showWordmark = true, tone = 'light' } = Astro.props;
---

<span class:list={['brand-logo', tone === 'dark' && 'is-dark']}>
	<img
		class="brand-logo-mark"
		src="/logo.svg"
		alt=""
		width={size}
		height={size}
		decoding="async"
	/>
	{
		showWordmark && (
			<span class="brand-text">
				<span class="brand-strong">Best Letting Agent</span>
				<span class="brand-soft">for Landlords</span>
			</span>
		)
	}
</span>

<style>
	.brand-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		color: inherit;
	}

	.brand-logo-mark {
		width: var(--logo-size, 36px);
		height: var(--logo-size, 36px);
		flex-shrink: 0;
		border-radius: 8px;
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--cream) 12%, transparent);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.brand-strong {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: -0.02em;
	}

	.brand-soft {
		font-size: 0.75rem;
		opacity: 0.78;
	}

	.is-dark .brand-logo-mark {
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
	}

	@media (max-width: 420px) {
		.brand-soft {
			display: none;
		}

		.brand-strong {
			font-size: 0.88rem;
		}

		.brand-logo {
			gap: 0.55rem;
		}
	}
</style>
