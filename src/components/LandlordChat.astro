---
import { chatChoices, chatGreeting } from '../data/chat-bot';
---

<div class="landlord-chat" data-landlord-chat>
	<button
		type="button"
		class="chat-launcher"
		data-chat-open
		aria-controls="landlord-chat-panel"
		aria-expanded="false"
	>
		<span class="chat-launcher-icon" aria-hidden="true">
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
				<path
					d="M5 18.5V7.8A2.8 2.8 0 0 1 7.8 5h8.4A2.8 2.8 0 0 1 19 7.8v6.4a2.8 2.8 0 0 1-2.8 2.8H9.2L5 20.5v-2Z"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linejoin="round"
				></path>
			</svg>
		</span>
		<span class="chat-launcher-label">Ask a landlord question</span>
	</button>

	<div
		id="landlord-chat-panel"
		class="chat-panel"
		data-chat-panel
		hidden
		role="dialog"
		aria-modal="true"
		aria-labelledby="chat-panel-title"
	>
		<header class="chat-header">
			<div class="chat-header-copy">
				<p class="chat-header-kicker">Chat with</p>
				<h2 id="chat-panel-title">Landlord assistant</h2>
			</div>
			<button type="button" class="chat-close" data-chat-close aria-label="Close chat">
				<span aria-hidden="true">×</span>
			</button>
		</header>

		<div class="chat-body" data-chat-body>
			<div class="chat-bubble bot" data-chat-greeting>
				<p>{chatGreeting}</p>
				<p class="chat-prompt">Please select an option:</p>
				<div class="chat-choices" role="list">
					{
						chatChoices.map((choice) => (
							<button
								type="button"
								class="chat-choice"
								role="listitem"
								data-chat-choice={choice.id}
								data-reply={choice.reply}
								data-href={choice.href ?? ''}
								data-cta={choice.cta ?? ''}
								data-label={choice.label}
							>
								<span>{choice.label}</span>
								<span aria-hidden="true">›</span>
							</button>
						))
					}
				</div>
			</div>
		</div>

		<p class="chat-foot">Guided help · not a live human agent</p>
	</div>
</div>

<script>
	const root = document.querySelector('[data-landlord-chat]');
	if (root instanceof HTMLElement) {
		const openBtn = root.querySelector('[data-chat-open]');
		const closeBtn = root.querySelector('[data-chat-close]');
		const panel = root.querySelector('[data-chat-panel]');
		const body = root.querySelector('[data-chat-body]');

		const setOpen = (open: boolean) => {
			if (!(panel instanceof HTMLElement) || !(openBtn instanceof HTMLButtonElement)) return;
			panel.hidden = !open;
			openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
			root.classList.toggle('is-open', open);
			if (open) {
				const first = panel.querySelector('.chat-choice, .chat-close');
				if (first instanceof HTMLElement) first.focus();
			} else {
				openBtn.focus();
			}
		};

		openBtn?.addEventListener('click', () => setOpen(true));
		closeBtn?.addEventListener('click', () => setOpen(false));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && root.classList.contains('is-open')) {
				setOpen(false);
			}
		});

		const appendUser = (label: string) => {
			if (!(body instanceof HTMLElement)) return;
			const bubble = document.createElement('div');
			bubble.className = 'chat-bubble user';
			bubble.innerHTML = `<p></p>`;
			const p = bubble.querySelector('p');
			if (p) p.textContent = label;
			body.appendChild(bubble);
			body.scrollTop = body.scrollHeight;
		};

		const appendBot = (reply: string, href: string, cta: string) => {
			if (!(body instanceof HTMLElement)) return;
			const bubble = document.createElement('div');
			bubble.className = 'chat-bubble bot';
			const p = document.createElement('p');
			p.textContent = reply;
			bubble.appendChild(p);
			if (href && cta) {
				const link = document.createElement('a');
				link.className = 'chat-cta';
				link.href = href;
				link.textContent = cta;
				bubble.appendChild(link);
			}
			const again = document.createElement('button');
			again.type = 'button';
			again.className = 'chat-again';
			again.textContent = 'Ask another question';
			again.addEventListener('click', () => {
				const greeting = body.querySelector('[data-chat-greeting]');
				body.querySelectorAll('.chat-bubble.user, .chat-bubble.bot:not([data-chat-greeting])').forEach((el) => el.remove());
				if (greeting instanceof HTMLElement) {
					greeting.hidden = false;
					body.scrollTop = 0;
				}
			});
			bubble.appendChild(again);
			body.appendChild(bubble);
			body.scrollTop = body.scrollHeight;
		};

		root.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const choice = target.closest('[data-chat-choice]');
			if (!(choice instanceof HTMLElement)) return;
			const href = choice.dataset.href || '';
			if (href) {
				setOpen(false);
				window.location.assign(href);
				return;
			}
			const label = choice.dataset.label || choice.textContent?.trim() || 'Question';
			const reply = choice.dataset.reply || '';
			const cta = choice.dataset.cta || '';
			const greeting = body?.querySelector('[data-chat-greeting]');
			if (greeting instanceof HTMLElement) greeting.hidden = true;
			appendUser(label);
			window.setTimeout(() => appendBot(reply, href, cta), 180);
		});
	}
</script>

<style>
	.landlord-chat {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 80;
		display: grid;
		justify-items: end;
		gap: 0.75rem;
		font-family: var(--font-body);
	}

	.chat-launcher {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.85rem 1.1rem;
		border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
		border-radius: var(--radius-lg);
		background: var(--ink);
		color: var(--cream);
		font: inherit;
		font-weight: 650;
		font-size: 0.98rem;
		cursor: pointer;
		box-shadow: 0 14px 36px color-mix(in srgb, black 28%, transparent);
		transition:
			transform 0.25s var(--ease),
			background 0.25s var(--ease);
	}

	.chat-launcher:hover {
		transform: translateY(-2px);
		background: var(--ink-soft);
	}

	.chat-launcher-icon {
		display: inline-flex;
		color: var(--brass);
	}

	.landlord-chat.is-open .chat-launcher {
		opacity: 0;
		pointer-events: none;
	}

	.chat-panel {
		width: min(24.5rem, calc(100vw - 1.5rem));
		max-height: min(34rem, calc(100svh - 2rem));
		display: grid;
		grid-template-rows: auto 1fr auto;
		background: var(--white);
		border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
		border-radius: var(--radius-lg);
		box-shadow: 0 22px 50px color-mix(in srgb, black 22%, transparent);
		overflow: hidden;
	}

	.chat-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.95rem 1rem;
		background: var(--ink);
		color: var(--cream);
	}

	.chat-header-kicker {
		margin: 0;
		font-size: 0.78rem;
		opacity: 0.75;
	}

	.chat-header h2 {
		margin: 0.1rem 0 0;
		font-size: 1.1rem;
		color: var(--cream);
		font-weight: 650;
	}

	.chat-close {
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid color-mix(in srgb, var(--cream) 25%, transparent);
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--cream);
		font-size: 1.45rem;
		line-height: 1;
		cursor: pointer;
	}

	.chat-close:hover {
		background: color-mix(in srgb, var(--cream) 10%, transparent);
	}

	.chat-body {
		overflow: auto;
		padding: 1rem;
		display: grid;
		gap: 0.85rem;
		align-content: start;
		background:
			radial-gradient(ellipse 80% 40% at 100% 0%, color-mix(in srgb, var(--mist) 70%, transparent), transparent),
			var(--paper);
	}

	.chat-bubble {
		max-width: 95%;
		padding: 0.9rem 1rem;
		background: var(--white);
		border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
		border-radius: var(--radius);
	}

	.chat-bubble.bot {
		justify-self: start;
	}

	.chat-bubble.user {
		justify-self: end;
		background: var(--ink);
		color: var(--cream);
		border-color: transparent;
	}

	.chat-bubble p {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.55;
		color: inherit;
	}

	.chat-bubble.bot p {
		color: var(--text);
	}

	.chat-prompt {
		margin-top: 0.85rem !important;
		font-weight: 650;
		color: var(--ink) !important;
	}

	.chat-choices {
		margin-top: 0.75rem;
		display: grid;
		gap: 0.5rem;
	}

	.chat-choice {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
		padding: 0.8rem 0.95rem;
		border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--mist) 55%, white);
		color: var(--ink);
		font: inherit;
		font-weight: 650;
		font-size: 0.95rem;
		text-align: left;
		cursor: pointer;
		transition:
			background 0.2s var(--ease),
			border-color 0.2s var(--ease),
			transform 0.2s var(--ease);
	}

	.chat-choice:hover {
		background: var(--white);
		border-color: color-mix(in srgb, var(--brass) 55%, var(--ink));
		transform: translateX(2px);
	}

	.chat-cta {
		display: inline-flex;
		margin-top: 0.85rem;
		padding: 0.7rem 0.95rem;
		border-radius: var(--radius-sm);
		background: var(--brass);
		color: var(--ink);
		font-weight: 650;
		text-decoration: none;
		font-size: 0.95rem;
	}

	.chat-cta:hover {
		background: color-mix(in srgb, var(--brass) 88%, white);
	}

	.chat-again {
		display: block;
		margin-top: 0.75rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--forest);
		font: inherit;
		font-weight: 650;
		font-size: 0.92rem;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.chat-foot {
		margin: 0;
		padding: 0.55rem 1rem;
		font-size: 0.78rem;
		color: var(--muted);
		text-align: center;
		border-top: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
		background: var(--white);
	}

	@media (max-width: 520px) {
		.chat-launcher-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}

		.chat-launcher {
			width: 3.25rem;
			height: 3.25rem;
			padding: 0;
			justify-content: center;
			border-radius: var(--radius-lg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.chat-launcher,
		.chat-choice {
			transition: none;
		}

		.chat-launcher:hover,
		.chat-choice:hover {
			transform: none;
		}
	}
</style>
