---
interface Props {
	src: string;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="guide-visual">
	<img src={src} alt={alt} width="800" height="500" loading="lazy" decoding="async" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.guide-visual {
		margin: 0 0 1.75rem;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
		background: var(--white);
		max-width: 42rem;
	}

	.guide-visual img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.guide-visual figcaption {
		padding: 0.75rem 1rem;
		font-size: 0.95rem;
		color: var(--muted);
		border-top: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
	}
</style>
