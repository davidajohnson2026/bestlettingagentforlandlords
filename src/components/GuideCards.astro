---
import { guideCards, type GuideCard } from '../data/guide-cards';

interface Props {
	heading?: string;
	exclude?: string;
	cards?: GuideCard[];
}

const {
	heading = 'More landlord guides',
	exclude,
	cards = guideCards,
} = Astro.props;

const items = exclude ? cards.filter((card) => card.href !== exclude) : cards;
---

{
	items.length > 0 && (
		<section class="guide-cards" aria-labelledby="guide-cards-heading">
			<div class="section-shell">
				<h2 id="guide-cards-heading">{heading}</h2>
				<ul class="guide-grid" role="list">
					{items.map((card) => (
						<li>
							<a class="guide-card" href={card.href}>
								<figure class="guide-media">
									<img
										src={card.image}
										alt={card.imageAlt}
										width="900"
										height="600"
										loading="lazy"
										decoding="async"
									/>
								</figure>
								<div class="guide-body">
									<h3>{card.title}</h3>
									<p>{card.blurb}</p>
									<span class="guide-more">
										Read more
										<span aria-hidden="true"> →</span>
									</span>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.guide-cards {
		background:
			radial-gradient(ellipse 70% 50% at 50% 0%, color-mix(in srgb, var(--mist) 90%, transparent), transparent),
			var(--paper);
	}

	.guide-cards h2 {
		text-align: center;
		font-size: clamp(1.75rem, 3.5vw, 2.4rem);
		color: var(--ink);
		margin: 0 0 2rem;
	}

	.guide-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.75rem 1.25rem;
	}

	.guide-card {
		display: grid;
		gap: 0.95rem;
		text-decoration: none;
		color: inherit;
		height: 100%;
		padding: 0.85rem;
		background: var(--white);
		border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
		border-radius: var(--radius-lg);
		box-shadow: 0 12px 30px color-mix(in srgb, var(--ink) 7%, transparent);
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}

	.guide-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 18px 36px color-mix(in srgb, var(--ink) 12%, transparent);
	}

	.guide-media {
		margin: 0;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		background: var(--mist);
		border-radius: var(--radius);
	}

	.guide-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.55s var(--ease);
	}

	.guide-card:hover .guide-media img {
		transform: scale(1.04);
	}

	.guide-body {
		display: grid;
		gap: 0.45rem;
		align-content: start;
		padding: 0.15rem 0.35rem 0.45rem;
	}

	.guide-body h3 {
		margin: 0;
		font-size: 1.15rem;
		color: var(--ink);
		line-height: 1.3;
	}

	.guide-body p {
		margin: 0;
		color: var(--muted);
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.guide-more {
		margin-top: 0.35rem;
		font-weight: 650;
		color: var(--forest);
		font-size: 0.95rem;
	}

	.guide-card:hover .guide-more {
		color: var(--brass-deep);
	}

	@media (min-width: 640px) {
		.guide-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem 1.5rem;
		}
	}

	@media (min-width: 960px) {
		.guide-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.75rem 1.35rem;
		}

		.guide-body h3 {
			font-size: 1.08rem;
		}

		.guide-body p {
			font-size: 0.92rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.guide-card,
		.guide-media img {
			transition: none;
		}

		.guide-card:hover {
			transform: none;
		}

		.guide-card:hover .guide-media img {
			transform: none;
		}
	}
</style>
