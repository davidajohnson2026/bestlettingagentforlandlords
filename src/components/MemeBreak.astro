---
interface Props {
	src: string;
	alt: string;
	caption: string;
	href?: string;
	cta?: string;
}

const { src, alt, caption, href, cta } = Astro.props;
---

<section class="meme-break" aria-label={caption}>
	<figure class="meme-frame">
		<img src={src} alt={alt} width="900" height="560" loading="lazy" decoding="async" />
		<figcaption>
			<p class="meme-caption">{caption}</p>
			{
				href && cta && (
					<a class="meme-cta" href={href}>
						{cta}
						<span aria-hidden="true"> →</span>
					</a>
				)
			}
		</figcaption>
	</figure>
</section>

<style>
	.meme-break {
		padding: 0;
		background: var(--ink);
	}

	.meme-frame {
		margin: 0;
		display: grid;
	}

	.meme-frame img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		max-height: 22rem;
	}

	.meme-frame figcaption {
		padding: 1.15rem clamp(1.15rem, 4vw, 2.5rem) 1.35rem;
		background: var(--ink);
		color: var(--cream);
		display: grid;
		gap: 0.75rem;
		justify-items: start;
	}

	.meme-caption {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 4vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.2;
		max-width: 22ch;
	}

	.meme-cta {
		color: var(--brass);
		font-weight: 650;
		text-decoration: none;
		border-bottom: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
		padding-bottom: 0.1rem;
	}

	.meme-cta:hover {
		color: color-mix(in srgb, var(--brass) 80%, white);
	}

	@media (min-width: 840px) {
		.meme-frame {
			grid-template-columns: 1.2fr 0.8fr;
			align-items: stretch;
			min-height: 18rem;
		}

		.meme-frame img {
			height: 100%;
			max-height: none;
			aspect-ratio: auto;
		}

		.meme-frame figcaption {
			padding: 2rem 2.25rem;
			align-content: center;
		}
	}
</style>
